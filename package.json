{
  "name": "northstar-playwright-quality-gate",
  "version": "1.0.0",
  "private": true,
  "description": "A local synthetic banking application with a Playwright quality gate.",
  "scripts": {
    "start": "node src/app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.2"
  }
}